#!/bin/sh
# Settings of the ThinkSmart kiosk (Weston + full-screen browser, thinksmart-kiosk.service).
#   kiosk-mode status
#   kiosk-mode url <URL>
#   kiosk-mode rotation <normal|90|180|270>
#   kiosk-mode restart          (applies url/rotation now; a reboot does too)
set -e
CONF=/etc/thinksmart-kiosk.conf

need_root() { [ "$(id -u)" = 0 ] || { echo "run with sudo"; exit 1; }; }

set_key() {
    tmp="${CONF}.tmp.$$"
    if [ -f "$CONF" ]; then
        cp -p "$CONF" "$tmp"
    else
        : > "$tmp"
        chmod 0644 "$tmp"
    fi
    if grep -q "^$1=" "$tmp"; then
        # & | and \ are special in the sed replacement (URLs often have &)
        v=$(printf '%s' "$2" | tr -d '\r\n' | sed 's/[&|\\]/\\&/g')
        sed -i "s|^$1=.*|$1=$v|" "$tmp"
    else
        printf '%s=%s\n' "$1" "$(printf '%s' "$2" | tr -d '\r\n')" >> "$tmp"
    fi
    mv -f "$tmp" "$CONF"
}

case "${1:-status}" in
    url)      need_root; clean_u=$(printf '%s' "${2:-}" | tr -d '"\r\n'); [ -n "$clean_u" ] || { echo "usage: kiosk-mode url <URL>"; exit 1; }
              set_key URL "\"$clean_u\""; printf 'URL set: %s (kiosk-mode restart to apply)\n' "$clean_u";;
    rotation) need_root; case "${2:-}" in normal|90|180|270) ;; *) echo "usage: kiosk-mode rotation <normal|90|180|270>"; exit 1;; esac
              set_key ROTATION "$2"; echo "rotation set: $2 (kiosk-mode restart to apply)";;
    restart)  need_root
              pkill -CONT -u ubuntu -f '(^|/)WebKit(Web|Network)Process( |$)' 2>/dev/null || true
              pkill -CONT -u ubuntu -f '^/usr/bin/python3( -B)? /usr/local/bin/thinksmart-kiosk\.py$' 2>/dev/null || true
              systemctl restart thinksmart-kiosk.service;;
    status)   systemctl is-active thinksmart-kiosk.service || true; [ -f "$CONF" ] && grep -E "^(URL|ROTATION|GPU)=" "$CONF" || true;;
    *)        echo "usage: kiosk-mode status|url <URL>|rotation <normal|90|180|270>|restart"; exit 1;;
esac

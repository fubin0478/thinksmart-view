#!/usr/bin/env python3
"""thinksmart-update (self-managed stub): upstream third-party online updates are permanently disabled."""
import json
import os
import sys
from pathlib import Path

UPDATER_VERSION = '1.0.0-self'
CONF = Path('/etc/thinksmart-update.conf')
STATE = Path('/var/lib/thinksmart-update')
STATUS = STATE / 'status.json'


def read_conf():
    conf = {'SOURCES': '', 'PROXY': '', 'REQUEST_GROUP': 'ubuntu'}
    if CONF.is_file():
        for line in CONF.read_text(encoding='utf-8', errors='replace').splitlines():
            line = line.strip()
            if not line or line.startswith('#') or '=' not in line:
                continue
            k, v = line.split('=', 1)
            conf[k.strip()] = v.strip().strip('"').strip("'")
    return conf


def write_self_managed_status():
    try:
        if STATUS.is_symlink():
            return
        STATE.mkdir(parents=True, exist_ok=True)
        req_dir = STATE / 'requests'
        if req_dir.is_dir():
            for p in req_dir.iterdir():
                if p.is_file() and not p.is_symlink():
                    p.unlink(missing_ok=True)
        tmp = STATE / f'.status.json.{os.getpid()}.tmp'
        payload = json.dumps({
            'enabled': False,
            'self_managed': True,
            'note': '自主维护版 · 已停用第三方在线更新',
        }, ensure_ascii=False).encode('utf-8')
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | getattr(os, 'O_NOFOLLOW', 0), 0o644)
        try:
            with os.fdopen(fd, 'wb') as f:
                os.fchmod(f.fileno(), 0o644)
                f.write(payload)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, STATUS)
        except Exception:
            try:
                tmp.unlink(missing_ok=True)
            except OSError:
                pass
            raise
    except OSError:
        pass


def main(argv=None):
    args = list(sys.argv[1:] if argv is None else argv)
    cmd = args[0] if args else 'selftest'
    conf = read_conf()
    if cmd == 'selftest':
        print(f'thinksmart-update {UPDATER_VERSION}', 'sources:', conf['SOURCES'] or '-')
        return 0
    write_self_managed_status()
    print('thinksmart-update: 已切换为本地自主维护模式，第三方在线更新已永久停用。')
    return 0


if __name__ == '__main__':
    sys.exit(main())

#!/bin/bash
# 2026-11-20 Claude：给联想 View 管理后台（/admin/）加一道密码，或者取消密码。
# 默认不用密码：和远程可视一样，只有连上指定的 VPS 节点或在家里局域网才能打开。
# 从标准输入读一行：至少 4 位（支持 账号:密码 或纯密码，只存 scrypt 哈希，不回显、不进日志）；空行 = 取消密码。
# 改了以后，已经登录的设备都要重新登录。
# 用法：在 Mac 上双击共享文件夹里的「设置管理后台密码.command」，它会提示输入两遍再交给这里。
set -euo pipefail
export LC_ALL=C.UTF-8
umask 077
if [ "$(id -u)" != 0 ]; then echo "需要 root 运行" >&2; exit 1; fi
if [ -L /var/lib ] || [ -L /var/lib/thinksmart-admin ]; then echo "状态目录路径异常（符号链接）" >&2; exit 1; fi
install -d -o ubuntu -g ubuntu -m 0700 /var/lib/thinksmart-admin
if ! IFS= read -r PW && [ -z "$PW" ]; then echo "未收到输入（连接中断），没有修改。" >&2; exit 1; fi
PW=${PW%$'\r'}
PW_CHK="$PW"
if [[ "$PW_CHK" == *:* ]]; then PW_CHK="${PW_CHK#*:}"; fi
if [ -n "$PW" ] && { [ "${#PW_CHK}" -lt 4 ] || [ "${#PW_CHK}" -gt 128 ]; }; then echo "密码长度要在 4～128 位之间，没有修改。" >&2; exit 2; fi
printf '%s\n' "$PW" | setpriv --reuid=ubuntu --regid=ubuntu --init-groups env ADMIN_STATE=/var/lib/thinksmart-admin PYTHONDONTWRITEBYTECODE=1 \
  /opt/thinksmart-addons/venv/bin/python /usr/local/bin/thinksmart-admin.py --set-password
unset PW PW_CHK

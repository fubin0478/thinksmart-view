# Mount in the system manager, never in a udev worker's private mount namespace.
ACTION=="add|change", SUBSYSTEM=="block", SUBSYSTEMS=="usb", KERNEL=="sd*", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_TYPE}=="vfat|exfat|ntfs|ext2|ext3|ext4", ENV{ID_PART_ENTRY_TYPE}!="c12a7328-f81f-11d2-ba4b-00a0c93ec93b", ENV{ID_PART_ENTRY_TYPE}!="0xef", TAG+="systemd", ENV{SYSTEMD_WANTS}+="thinksmart-usb-mount@%k.service"

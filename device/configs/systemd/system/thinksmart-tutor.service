[Unit]
Description=ThinkSmart AI Dynamic Blackboard Tutor Service (Port 8096)
After=network-online.target user@1000.service
Wants=network-online.target

[Service]
User=ubuntu
SupplementaryGroups=video audio
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 XDG_RUNTIME_DIR=/run/user/1000 PULSE_SERVER=unix:/run/user/1000/pulse/native
ExecStart=/opt/thinksmart-addons/venv/bin/python /usr/local/bin/thinksmart-tutor.py
Restart=on-failure
RestartSec=4
ReadWritePaths=-/run/user/1000
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
StateDirectory=thinksmart-tutor
StateDirectoryMode=0700
MemoryHigh=144M
MemoryMax=200M
TasksMax=48
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target

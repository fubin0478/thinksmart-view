<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.thinksmart.hy-mt2</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/llama-server</string>
		<string>-m</string>
		<string>/Users/YOUR_USERNAME/thinksmart-view/mac-companion/voice-server/models/hy-mt2/Hy-MT2-1.8B-Q8_0.gguf</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8082</string>
		<string>--alias</string>
		<string>hy-mt2-local</string>
		<string>-ngl</string>
		<string>99</string>
		<string>-t</string>
		<string>8</string>
		<string>-tb</string>
		<string>8</string>
		<string>-c</string>
		<string>8192</string>
		<string>-np</string>
		<string>2</string>
		<string>-b</string>
		<string>2048</string>
		<string>-ub</string>
		<string>512</string>
		<string>--jinja</string>
		<string>-fa</string>
		<string>on</string>
		<string>--cache-ram</string>
		<string>512</string>
		<string>--sleep-idle-seconds</string>
		<string>600</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/YOUR_USERNAME/Library/Logs/xiaozhi-voice/hy-mt2.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/YOUR_USERNAME/Library/Logs/xiaozhi-voice/hy-mt2.out.log</string>
	<key>WorkingDirectory</key>
	<string>/Users/YOUR_USERNAME/thinksmart-view/mac-companion/voice-server</string>
</dict>
</plist>

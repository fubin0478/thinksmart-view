<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.thinksmart.gateway</string>
  <key>ProcessType</key>
  <string>Interactive</string>

  <!-- Token-protected public entrance (port 8080) to the 8010 ASR/TTS/translation & 8084 study-vision routes -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/thinksmart-view/mac-companion/voice-server/.venv/bin/python</string>
    <string>/Users/YOUR_USERNAME/thinksmart-view/mac-companion/voice-server/public_gateway.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/xiaozhi-voice/gateway.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/xiaozhi-voice/gateway.err.log</string>
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/thinksmart-view/mac-companion/voice-server</string>
</dict>
</plist>

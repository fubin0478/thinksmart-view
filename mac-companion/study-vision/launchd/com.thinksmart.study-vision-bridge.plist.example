<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.thinksmart.study-vision-bridge</string>
  <!-- Encrypted study-monitor bridge (127.0.0.1:8084); public_gateway.py relays /<token>/study/v1 here.
       For dual-Mac split compute, set STUDY_VISION_LLM to http://<VISION_MAC_LAN_IP>:8083 and STUDY_VISION_VOICE_WAIT_MAX to 0. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USERNAME/thinksmart-view/mac-companion/voice-server/.venv/bin/python</string>
    <string>/Users/YOUR_USERNAME/thinksmart-view/mac-companion/study-vision/vision_bridge.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
    <key>STUDY_VISION_LLM</key>
    <string>http://127.0.0.1:8083</string>
    <key>STUDY_VISION_MODEL</key>
    <string>qwen3.5-9b</string>
  </dict>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/study-vision/bridge.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USERNAME/Library/Logs/study-vision/bridge.err.log</string>
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USERNAME/thinksmart-view/mac-companion/study-vision</string>
</dict>
</plist>

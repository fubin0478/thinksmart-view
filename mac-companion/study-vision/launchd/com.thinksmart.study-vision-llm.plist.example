<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.thinksmart.study-vision-llm</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/bin/llama-server</string>
		<string>-m</string>
		<string>/Users/YOUR_USERNAME/thinksmart-view/mac-companion/study-vision/models/Qwen3.5-9B-Q8_0.gguf</string>
		<string>--mmproj</string>
		<string>/Users/YOUR_USERNAME/thinksmart-view/mac-companion/study-vision/models/mmproj-F16.gguf</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8083</string>
		<string>--alias</string>
		<string>qwen3.5-9b,qwen3-vl-8b</string>
		<string>-ngl</string>
		<string>99</string>
		<string>-c</string>
		<string>4096</string>
		<string>-np</string>
		<string>1</string>
		<string>-fa</string>
		<string>on</string>
		<string>--image-max-tokens</string>
		<string>1024</string>
		<string>-ctk</string>
		<string>q8_0</string>
		<string>-ctv</string>
		<string>q8_0</string>
		<string>--cache-ram</string>
		<string>512</string>
		<string>--sleep-idle-seconds</string>
		<string>600</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/YOUR_USERNAME/Library/Logs/study-vision/llm.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/YOUR_USERNAME/Library/Logs/study-vision/llm.out.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>/Users/YOUR_USERNAME/thinksmart-view/mac-companion/study-vision</string>
</dict>
</plist>
